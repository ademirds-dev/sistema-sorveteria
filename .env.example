# Copie este arquivo para .env e ajuste os valores.
# O .env NÃO é versionado (está no .gitignore).

# -------- Banco de dados (usado a partir da Fase 0 do roadmap) --------
# PostgreSQL local de exemplo:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sorveteria?schema=public"

# -------- Autenticação (Auth.js / NextAuth) — Fase 0 --------
# Gere um segredo com:  npx auth secret   (ou openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-aleatorio"
# URL base da app em desenvolvimento:
NEXTAUTH_URL="http://localhost:3000"

# -------- Importação de NF por foto / OCR (Fase 3) --------
# Chave da API usada pela extração de itens da nota por imagem.
# ANTHROPIC_API_KEY=""
